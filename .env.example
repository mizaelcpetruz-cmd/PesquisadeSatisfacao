# ==============================================================================
# Petruz Satisfaction NPS System — Environment Configuration
# ==============================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Server-side)
# ------------------------------------------------------------------------------
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_USER=pesquisa@petruz.com
SMTP_PASS=your-smtp-password
SMTP_FROM=pesquisa@petruz.com

# ------------------------------------------------------------------------------
# SAP Business One — Service Layer Configuration
# ------------------------------------------------------------------------------
SAP_SL_URL=https://your-sap-server.com:50000/b1s/v2/
SAP_SL_COMPANY_DB=SBO_PETRUZ
SAP_SL_USERNAME=manager
SAP_SL_PASSWORD=your-sap-password

# ------------------------------------------------------------------------------
# Zenvia WhatsApp API Configuration
# ------------------------------------------------------------------------------
ZENVIA_API_TOKEN=your-zenvia-api-token
ZENVIA_FROM=your-zenvia-registered-sender
ZENVIA_WEBHOOK_SECRET=your-secure-webhook-secret-token

# ------------------------------------------------------------------------------
# Cron Security & Schedulers
# ------------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-key

# ------------------------------------------------------------------------------
# System Alerts & Notifications
# ------------------------------------------------------------------------------
DISABLE_ALERTS=false
